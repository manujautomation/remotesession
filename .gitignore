target/
*.deb
*.exe
*.zip

# Side-effects of running flutter with HOME set to the repo (containerised builds)
.config/
.dart-tool/
.flutter
.flutter-devtools/

# Upstream ignores *svg wholesale; our mark is a real source asset and must ship.
# Without this the Windows CI build has no logo and loadLogo() throws at runtime.
!flutter/assets/mendocino_mark.svg
